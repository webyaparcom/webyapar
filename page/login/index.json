  "text": {
    "tr": "<style>\n#wylogin{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 16px 48px;box-sizing:border-box}\n#wylogin *{box-sizing:border-box}\n#wylogin .wylogin-kart{width:100%;max-width:460px;background:var(--mx-site-surface,#ffffff);color:var(--mx-site-text,#1b1b1b);border:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 14%,transparent);border-radius:16px;box-shadow:0 12px 32px color-mix(in srgb,var(--mx-site-text,#1b1b1b) 10%,transparent);overflow:hidden}\n#wylogin .wylogin-sekmeler{display:flex;border-bottom:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 14%,transparent)}\n#wylogin .wylogin-sekme{flex:1;min-height:48px;padding:12px 8px;border:0;border-bottom:3px solid transparent;background:transparent;color:inherit;font:inherit;font-size:15px;font-weight:600;cursor:pointer;opacity:.72;transition:opacity .2s ease,border-color .2s ease}\n#wylogin .wylogin-sekme:hover{opacity:1}\n#wylogin .wylogin-sekme[aria-selected=\"true\"]{opacity:1;border-bottom-color:var(--mx-site-primary,#CC1F1B);color:var(--mx-site-primary,#CC1F1B)}\n#wylogin .wylogin-sekme:focus-visible{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:-2px}\n#wylogin .wylogin-panel{padding:24px}\n#wylogin .wylogin-panel[hidden]{display:none}\n#wylogin .wylogin-panel h2{margin:0 0 6px;font-size:22px;line-height:1.3}\n#wylogin .wylogin-panel>p{margin:0 0 18px;font-size:14px;line-height:1.55;opacity:.8}\n#wylogin form{display:flex;flex-direction:column;gap:14px;margin:0}\n#wylogin label{display:block;margin:0 0 6px;font-size:14px;font-weight:600}\n#wylogin label span{font-weight:400;opacity:.7}\n#wylogin input,#wylogin textarea{width:100%;min-height:46px;padding:10px 12px;border:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 24%,transparent);border-radius:10px;background:var(--mx-site-bg,#ffffff);color:var(--mx-site-text,#1b1b1b);font:inherit;font-size:16px}\n#wylogin textarea{min-height:90px;resize:vertical}\n#wylogin input:focus,#wylogin textarea:focus{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:1px;border-color:var(--mx-site-primary,#CC1F1B)}\n#wylogin .wylogin-sifre{position:relative}\n#wylogin .wylogin-sifre input{padding-inline-end:84px}\n#wylogin .wylogin-goster{position:absolute;inset-inline-end:6px;top:50%;transform:translateY(-50%);min-height:34px;padding:4px 10px;border:0;border-radius:8px;background:transparent;color:var(--mx-site-primary,#CC1F1B);font:inherit;font-size:13px;font-weight:600;cursor:pointer}\n#wylogin .wylogin-dugme{width:100%;min-height:48px;margin-top:4px;padding:12px 18px;border:0;border-radius:10px;background:var(--mx-site-primary,#CC1F1B);color:var(--mx-site-primary-contrast,#ffffff);font:inherit;font-size:16px;font-weight:700;cursor:pointer;transition:filter .2s ease}\n#wylogin .wylogin-dugme:hover{filter:brightness(1.08)}\n#wylogin .wylogin-dugme:disabled{opacity:.6;cursor:wait}\n#wylogin .wylogin-dugme:focus-visible{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:2px}\n#wylogin .wylogin-mesaj{margin:0;padding:10px 12px;border-radius:10px;font-size:14px;line-height:1.45;background:color-mix(in srgb,#d93025 10%,transparent);color:#b3261e;border:1px solid color-mix(in srgb,#d93025 30%,transparent)}\n#wylogin .wylogin-mesaj[hidden]{display:none}\n#wylogin .wylogin-alt{margin:16px 0 0;font-size:14px;line-height:1.55;text-align:center}\n#wylogin .wylogin-alt a,#wylogin .wylogin-baglanti{color:var(--mx-site-primary,#CC1F1B);font-weight:600;text-decoration:underline;text-underline-offset:2px;background:none;border:0;padding:0;font:inherit;font-size:14px;cursor:pointer}\n#wylogin .wylogin-kvkk{margin:16px 0 0;font-size:12px;line-height:1.5;opacity:.75;text-align:center}\n#wylogin .wylogin-kvkk a{color:inherit}\n@media (max-width:520px){#wylogin{padding:0 0 32px}#wylogin .wylogin-kart{border-radius:0;border-inline:0;box-shadow:none}#wylogin .wylogin-panel{padding:20px 16px}#wylogin .wylogin-sekme{font-size:14px;padding:12px 4px}}\n</style>\n<section class=\"wylogin\" id=\"wylogin\" data-metin=\"{&quot;goster&quot;: &quot;Göster&quot;, &quot;gizle&quot;: &quot;Gizle&quot;, &quot;b1&quot;: &quot;Giriş Yap&quot;, &quot;bekle&quot;: &quot;Giriş yapılıyor…&quot;, &quot;hata&quot;: &quot;E-posta veya şifre hatalı.&quot;, &quot;cok&quot;: &quot;Çok fazla deneme. Lütfen 15 dakika sonra tekrar deneyin.&quot;, &quot;ag&quot;: &quot;Bağlantı kurulamadı. Lütfen tekrar deneyin.&quot;, &quot;eksik&quot;: &quot;E-posta ve şifre gerekli.&quot;, &quot;gonder&quot;: &quot;Gönderiliyor…&quot;}\">\n<div class=\"wylogin-kart\">\n<div class=\"wylogin-sekmeler\" role=\"tablist\" aria-label=\"Giriş seçenekleri\">\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-giris\" data-sekme=\"giris\" aria-controls=\"wylogin-panel-giris\" aria-selected=\"true\">Giriş Yap</button>\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-uye-ol\" data-sekme=\"uye-ol\" aria-controls=\"wylogin-panel-uye-ol\" aria-selected=\"false\" tabindex=\"-1\">Üye Ol</button>\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-sifre\" data-sekme=\"sifre\" aria-controls=\"wylogin-panel-sifre\" aria-selected=\"false\" tabindex=\"-1\">Şifremi unuttum</button>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-giris\" aria-labelledby=\"wylogin-sekme-giris\">\n<h2>Müşteri portalına giriş</h2><p>Webyapar müşteri panelinize e-posta adresiniz ve şifrenizle girin.</p>\n<form id=\"wylogin-giris-form\" method=\"post\" action=\"/api/portal/giris\" novalidate>\n<p class=\"wylogin-mesaj\" id=\"wylogin-mesaj\" role=\"alert\" hidden></p>\n<div><label for=\"wylogin-eposta\">E-posta</label><input id=\"wylogin-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"username\" inputmode=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-sifre\">Şifre</label><div class=\"wylogin-sifre\"><input id=\"wylogin-sifre\" name=\"sifre\" type=\"password\" autocomplete=\"current-password\" maxlength=\"128\" required><button type=\"button\" class=\"wylogin-goster\" aria-controls=\"wylogin-sifre\" aria-pressed=\"false\">Göster</button></div></div>\n<button type=\"submit\" class=\"wylogin-dugme\">Giriş Yap</button>\n</form>\n<p class=\"wylogin-alt\"><a href=\"#sifre\" data-git=\"sifre\">Şifremi unuttum</a></p>\n<p class=\"wylogin-alt\">Hesabınız yok mu? <a href=\"#uye-ol\" data-git=\"uye-ol\">Üyelik talebi gönderin</a></p>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-uye-ol\" aria-labelledby=\"wylogin-sekme-uye-ol\" hidden>\n<h2>Üyelik talebi</h2><p>Bilgilerinizi bırakın; Webyapar ekibi talebinizi değerlendirip 7 gün içinde size ulaşır. Portal hesabı, gönderilen davet bağlantısıyla açılır.</p>\n<form method=\"POST\" action=\"/musteri/uyelik-talebi\" data-belirtec=\"uyelik\">\n<input type=\"hidden\" name=\"csrf\" value=\"\">\n<div><label for=\"wylogin-u-ad\">Ad Soyad</label><input id=\"wylogin-u-ad\" name=\"ad\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" required></div>\n<div><label for=\"wylogin-u-eposta\">E-posta</label><input id=\"wylogin-u-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-u-sirket\">Şirket</label><input id=\"wylogin-u-sirket\" name=\"sirket\" type=\"text\" autocomplete=\"organization\" maxlength=\"160\" required></div>\n<div><label for=\"wylogin-u-notu\">Not <span>(isteğe bağlı)</span></label><textarea id=\"wylogin-u-notu\" name=\"notu\" maxlength=\"2000\"></textarea></div>\n<button type=\"submit\" class=\"wylogin-dugme\">Üye Ol</button>\n</form>\n<p class=\"wylogin-kvkk\">Bilgileriniz yalnız talebinizi değerlendirmek için kullanılır · <a href=\"/musteri/kvkk\">KVKK aydınlatma metni</a></p>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-sifre\" aria-labelledby=\"wylogin-sekme-sifre\" hidden>\n<h2>Şifremi unuttum</h2><p>Portalda kayıtlı e-posta adresinizi ve adınızı yazın; kimliğinizi doğrulayıp şifrenizi yeniden belirlemeniz için size ulaşalım.</p>\n<form method=\"POST\" action=\"/musteri/sifre-unuttum\" data-belirtec=\"sifre\">\n<input type=\"hidden\" name=\"csrf\" value=\"\">\n<div><label for=\"wylogin-s-eposta\">E-posta</label><input id=\"wylogin-s-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-s-ad\">Ad Soyad</label><input id=\"wylogin-s-ad\" name=\"ad\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" required></div>\n<div><label for=\"wylogin-s-telefon\">Telefon <span>(isteğe bağlı)</span></label><input id=\"wylogin-s-telefon\" name=\"telefon\" type=\"tel\" autocomplete=\"tel\" maxlength=\"30\"></div>\n<button type=\"submit\" class=\"wylogin-dugme\">Gönder</button>\n</form>\n<p class=\"wylogin-kvkk\">Bilgileriniz yalnız talebinizi değerlendirmek için kullanılır · <a href=\"/musteri/kvkk\">KVKK aydınlatma metni</a></p>\n</div>\n</div>\n</section>\n<script>\n(function () {\n  var kok = document.getElementById(\"wylogin\");\n  if (!kok) return;\n  var M = JSON.parse(kok.getAttribute(\"data-metin\"));\n  var trMi = (document.documentElement.lang || \"tr\").slice(0, 2) === \"tr\";\n  var sekmeler = kok.querySelectorAll(\".wylogin-sekme\");\n  var BELIRTEC = { uyelik: \"/musteri/uyelik\", sifre: \"/musteri/sifre-unuttum\" };\n\n  function belirtecAl(form, bitti) {\n    var tur = form.getAttribute(\"data-belirtec\");\n    var alan = form.querySelector(\"input[name=csrf]\");\n    if (!tur || !alan || alan.value) { if (bitti) bitti(); return; }\n    fetch(BELIRTEC[tur], { credentials: \"include\", headers: { \"Accept\": \"text/html\" } })\n      .then(function (r) { return r.ok ? r.text() : \"\"; })\n      .then(function (html) {\n        var d = new DOMParser().parseFromString(html, \"text/html\");\n        var g = d.querySelector(\"input[name=csrf]\");\n        if (g && g.value) alan.value = g.value;\n      })\n      .catch(function () {})\n      .then(function () { if (bitti) bitti(); });\n  }\n\n  function sec(ad, odak) {\n    for (var i = 0; i < sekmeler.length; i++) {\n      var s = sekmeler[i];\n      var acik = s.getAttribute(\"data-sekme\") === ad;\n      s.setAttribute(\"aria-selected\", acik ? \"true\" : \"false\");\n      s.tabIndex = acik ? 0 : -1;\n      var p = document.getElementById(s.getAttribute(\"aria-controls\"));\n      p.hidden = !acik;\n      if (acik) {\n        var f = p.querySelector(\"form\");\n        if (f) belirtecAl(f);\n        if (odak) s.focus();\n      }\n    }\n  }\n  for (var i = 0; i < sekmeler.length; i++) {\n    sekmeler[i].addEventListener(\"click\", function () { sec(this.getAttribute(\"data-sekme\")); });\n    sekmeler[i].addEventListener(\"keydown\", function (e) {\n      if (e.key !== \"ArrowRight\" && e.key !== \"ArrowLeft\") return;\n      var dizi = Array.prototype.slice.call(sekmeler);\n      var n = dizi.indexOf(this);\n      var ileri = (e.key === \"ArrowRight\") !== (document.documentElement.dir === \"rtl\");\n      var y = dizi[(n + (ileri ? 1 : dizi.length - 1)) % dizi.length];\n      sec(y.getAttribute(\"data-sekme\"), true);\n      e.preventDefault();\n    });\n  }\n  var gecis = kok.querySelectorAll(\"[data-git]\");\n  for (var j = 0; j < gecis.length; j++) {\n    gecis[j].addEventListener(\"click\", function (e) { e.preventDefault(); sec(this.getAttribute(\"data-git\"), true); });\n  }\n  var ilk = (location.hash || \"\").replace(\"#\", \"\");\n  sec(ilk === \"uye-ol\" || ilk === \"sifre\" ? ilk : \"giris\");\n\n  var goster = kok.querySelector(\".wylogin-goster\");\n  goster.addEventListener(\"click\", function () {\n    var inp = document.getElementById(\"wylogin-sifre\");\n    var gizli = inp.type === \"password\";\n    inp.type = gizli ? \"text\" : \"password\";\n    goster.textContent = gizli ? M.gizle : M.goster;\n    goster.setAttribute(\"aria-pressed\", gizli ? \"true\" : \"false\");\n  });\n\n  var gf = document.getElementById(\"wylogin-giris-form\");\n  var mesaj = document.getElementById(\"wylogin-mesaj\");\n  var dugme = gf.querySelector(\"button[type=submit]\");\n  function hata(metin) { mesaj.textContent = metin; mesaj.hidden = false; dugme.disabled = false; dugme.textContent = M.b1; }\n  gf.addEventListener(\"submit\", function (e) {\n    e.preventDefault();\n    var eposta = gf.eposta.value.trim();\n    var sifre = gf.sifre.value;\n    if (!eposta || !sifre) { hata(M.eksik); return; }\n    mesaj.hidden = true;\n    dugme.disabled = true;\n    dugme.textContent = M.bekle;\n    fetch(\"/api/portal/giris\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ eposta: eposta, sifre: sifre }),\n      credentials: \"include\"\n    }).then(function (res) {\n      if (res.ok) { window.location.href = \"/musteri\"; return; }\n      return res.json().catch(function () { return {}; }).then(function (j) {\n        var sunucu = j && (j.hata || j.mesaj || j.error);\n        if (trMi && sunucu) hata(sunucu);\n        else hata(res.status === 429 ? M.cok : M.hata);\n      });\n    }).catch(function () { hata(M.ag); });\n  });\n\n  var formlar = kok.querySelectorAll(\"form[data-belirtec]\");\n  for (var k = 0; k < formlar.length; k++) {\n    formlar[k].addEventListener(\"submit\", function (e) {\n      var f = this;\n      var b = f.querySelector(\"button[type=submit]\");\n      if (f.getAttribute(\"data-gonderiliyor\")) { e.preventDefault(); return; }\n      if (f.querySelector(\"input[name=csrf]\").value) { f.setAttribute(\"data-gonderiliyor\", \"1\"); b.disabled = true; b.textContent = M.gonder; return; }\n      e.preventDefault();\n      f.setAttribute(\"data-gonderiliyor\", \"1\");\n      b.disabled = true;\n      b.textContent = M.gonder;\n      belirtecAl(f, function () { f.submit(); });\n    });\n  }\n})();\n</script>",
    "en": "<style>\n#wylogin{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 16px 48px;box-sizing:border-box}\n#wylogin *{box-sizing:border-box}\n#wylogin .wylogin-kart{width:100%;max-width:460px;background:var(--mx-site-surface,#ffffff);color:var(--mx-site-text,#1b1b1b);border:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 14%,transparent);border-radius:16px;box-shadow:0 12px 32px color-mix(in srgb,var(--mx-site-text,#1b1b1b) 10%,transparent);overflow:hidden}\n#wylogin .wylogin-sekmeler{display:flex;border-bottom:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 14%,transparent)}\n#wylogin .wylogin-sekme{flex:1;min-height:48px;padding:12px 8px;border:0;border-bottom:3px solid transparent;background:transparent;color:inherit;font:inherit;font-size:15px;font-weight:600;cursor:pointer;opacity:.72;transition:opacity .2s ease,border-color .2s ease}\n#wylogin .wylogin-sekme:hover{opacity:1}\n#wylogin .wylogin-sekme[aria-selected=\"true\"]{opacity:1;border-bottom-color:var(--mx-site-primary,#CC1F1B);color:var(--mx-site-primary,#CC1F1B)}\n#wylogin .wylogin-sekme:focus-visible{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:-2px}\n#wylogin .wylogin-panel{padding:24px}\n#wylogin .wylogin-panel[hidden]{display:none}\n#wylogin .wylogin-panel h2{margin:0 0 6px;font-size:22px;line-height:1.3}\n#wylogin .wylogin-panel>p{margin:0 0 18px;font-size:14px;line-height:1.55;opacity:.8}\n#wylogin form{display:flex;flex-direction:column;gap:14px;margin:0}\n#wylogin label{display:block;margin:0 0 6px;font-size:14px;font-weight:600}\n#wylogin label span{font-weight:400;opacity:.7}\n#wylogin input,#wylogin textarea{width:100%;min-height:46px;padding:10px 12px;border:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 24%,transparent);border-radius:10px;background:var(--mx-site-bg,#ffffff);color:var(--mx-site-text,#1b1b1b);font:inherit;font-size:16px}\n#wylogin textarea{min-height:90px;resize:vertical}\n#wylogin input:focus,#wylogin textarea:focus{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:1px;border-color:var(--mx-site-primary,#CC1F1B)}\n#wylogin .wylogin-sifre{position:relative}\n#wylogin .wylogin-sifre input{padding-inline-end:84px}\n#wylogin .wylogin-goster{position:absolute;inset-inline-end:6px;top:50%;transform:translateY(-50%);min-height:34px;padding:4px 10px;border:0;border-radius:8px;background:transparent;color:var(--mx-site-primary,#CC1F1B);font:inherit;font-size:13px;font-weight:600;cursor:pointer}\n#wylogin .wylogin-dugme{width:100%;min-height:48px;margin-top:4px;padding:12px 18px;border:0;border-radius:10px;background:var(--mx-site-primary,#CC1F1B);color:var(--mx-site-primary-contrast,#ffffff);font:inherit;font-size:16px;font-weight:700;cursor:pointer;transition:filter .2s ease}\n#wylogin .wylogin-dugme:hover{filter:brightness(1.08)}\n#wylogin .wylogin-dugme:disabled{opacity:.6;cursor:wait}\n#wylogin .wylogin-dugme:focus-visible{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:2px}\n#wylogin .wylogin-mesaj{margin:0;padding:10px 12px;border-radius:10px;font-size:14px;line-height:1.45;background:color-mix(in srgb,#d93025 10%,transparent);color:#b3261e;border:1px solid color-mix(in srgb,#d93025 30%,transparent)}\n#wylogin .wylogin-mesaj[hidden]{display:none}\n#wylogin .wylogin-alt{margin:16px 0 0;font-size:14px;line-height:1.55;text-align:center}\n#wylogin .wylogin-alt a,#wylogin .wylogin-baglanti{color:var(--mx-site-primary,#CC1F1B);font-weight:600;text-decoration:underline;text-underline-offset:2px;background:none;border:0;padding:0;font:inherit;font-size:14px;cursor:pointer}\n#wylogin .wylogin-kvkk{margin:16px 0 0;font-size:12px;line-height:1.5;opacity:.75;text-align:center}\n#wylogin .wylogin-kvkk a{color:inherit}\n@media (max-width:520px){#wylogin{padding:0 0 32px}#wylogin .wylogin-kart{border-radius:0;border-inline:0;box-shadow:none}#wylogin .wylogin-panel{padding:20px 16px}#wylogin .wylogin-sekme{font-size:14px;padding:12px 4px}}\n</style>\n<section class=\"wylogin\" id=\"wylogin\" data-metin=\"{&quot;goster&quot;: &quot;Show&quot;, &quot;gizle&quot;: &quot;Hide&quot;, &quot;b1&quot;: &quot;Sign In&quot;, &quot;bekle&quot;: &quot;Signing in…&quot;, &quot;hata&quot;: &quot;Incorrect e-mail or password.&quot;, &quot;cok&quot;: &quot;Too many attempts. Please try again in 15 minutes.&quot;, &quot;ag&quot;: &quot;Could not connect. Please try again.&quot;, &quot;eksik&quot;: &quot;E-mail and password are required.&quot;, &quot;gonder&quot;: &quot;Sending…&quot;}\">\n<div class=\"wylogin-kart\">\n<div class=\"wylogin-sekmeler\" role=\"tablist\" aria-label=\"Sign-in options\">\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-giris\" data-sekme=\"giris\" aria-controls=\"wylogin-panel-giris\" aria-selected=\"true\">Sign In</button>\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-uye-ol\" data-sekme=\"uye-ol\" aria-controls=\"wylogin-panel-uye-ol\" aria-selected=\"false\" tabindex=\"-1\">Register</button>\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-sifre\" data-sekme=\"sifre\" aria-controls=\"wylogin-panel-sifre\" aria-selected=\"false\" tabindex=\"-1\">Forgot password</button>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-giris\" aria-labelledby=\"wylogin-sekme-giris\">\n<h2>Customer portal sign-in</h2><p>Sign in to your Webyapar customer panel with your e-mail address and password.</p>\n<form id=\"wylogin-giris-form\" method=\"post\" action=\"/api/portal/giris\" novalidate>\n<p class=\"wylogin-mesaj\" id=\"wylogin-mesaj\" role=\"alert\" hidden></p>\n<div><label for=\"wylogin-eposta\">E-mail</label><input id=\"wylogin-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"username\" inputmode=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-sifre\">Password</label><div class=\"wylogin-sifre\"><input id=\"wylogin-sifre\" name=\"sifre\" type=\"password\" autocomplete=\"current-password\" maxlength=\"128\" required><button type=\"button\" class=\"wylogin-goster\" aria-controls=\"wylogin-sifre\" aria-pressed=\"false\">Show</button></div></div>\n<button type=\"submit\" class=\"wylogin-dugme\">Sign In</button>\n</form>\n<p class=\"wylogin-alt\"><a href=\"#sifre\" data-git=\"sifre\">Forgot your password?</a></p>\n<p class=\"wylogin-alt\">No account yet? <a href=\"#uye-ol\" data-git=\"uye-ol\">Send a membership request</a></p>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-uye-ol\" aria-labelledby=\"wylogin-sekme-uye-ol\" hidden>\n<h2>Membership request</h2><p>Leave your details; the Webyapar team reviews your request and gets back to you within 7 days. Your portal account is opened with the invitation link we send.</p>\n<form method=\"POST\" action=\"/musteri/uyelik-talebi\" data-belirtec=\"uyelik\">\n<input type=\"hidden\" name=\"csrf\" value=\"\">\n<div><label for=\"wylogin-u-ad\">Full name</label><input id=\"wylogin-u-ad\" name=\"ad\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" required></div>\n<div><label for=\"wylogin-u-eposta\">E-mail</label><input id=\"wylogin-u-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-u-sirket\">Company</label><input id=\"wylogin-u-sirket\" name=\"sirket\" type=\"text\" autocomplete=\"organization\" maxlength=\"160\" required></div>\n<div><label for=\"wylogin-u-notu\">Note <span>(optional)</span></label><textarea id=\"wylogin-u-notu\" name=\"notu\" maxlength=\"2000\"></textarea></div>\n<button type=\"submit\" class=\"wylogin-dugme\">Register</button>\n</form>\n<p class=\"wylogin-kvkk\">Your details are used only to evaluate your request · <a href=\"/musteri/kvkk\">Privacy notice (KVKK)</a></p>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-sifre\" aria-labelledby=\"wylogin-sekme-sifre\" hidden>\n<h2>Forgot password</h2><p>Enter the e-mail address registered in the portal and your name; we will contact you to verify your identity so you can set a new password.</p>\n<form method=\"POST\" action=\"/musteri/sifre-unuttum\" data-belirtec=\"sifre\">\n<input type=\"hidden\" name=\"csrf\" value=\"\">\n<div><label for=\"wylogin-s-eposta\">E-mail</label><input id=\"wylogin-s-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-s-ad\">Full name</label><input id=\"wylogin-s-ad\" name=\"ad\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" required></div>\n<div><label for=\"wylogin-s-telefon\">Phone <span>(optional)</span></label><input id=\"wylogin-s-telefon\" name=\"telefon\" type=\"tel\" autocomplete=\"tel\" maxlength=\"30\"></div>\n<button type=\"submit\" class=\"wylogin-dugme\">Send</button>\n</form>\n<p class=\"wylogin-kvkk\">Your details are used only to evaluate your request · <a href=\"/musteri/kvkk\">Privacy notice (KVKK)</a></p>\n</div>\n</div>\n</section>\n<script>\n(function () {\n  var kok = document.getElementById(\"wylogin\");\n  if (!kok) return;\n  var M = JSON.parse(kok.getAttribute(\"data-metin\"));\n  var trMi = (document.documentElement.lang || \"tr\").slice(0, 2) === \"tr\";\n  var sekmeler = kok.querySelectorAll(\".wylogin-sekme\");\n  var BELIRTEC = { uyelik: \"/musteri/uyelik\", sifre: \"/musteri/sifre-unuttum\" };\n\n  function belirtecAl(form, bitti) {\n    var tur = form.getAttribute(\"data-belirtec\");\n    var alan = form.querySelector(\"input[name=csrf]\");\n    if (!tur || !alan || alan.value) { if (bitti) bitti(); return; }\n    fetch(BELIRTEC[tur], { credentials: \"include\", headers: { \"Accept\": \"text/html\" } })\n      .then(function (r) { return r.ok ? r.text() : \"\"; })\n      .then(function (html) {\n        var d = new DOMParser().parseFromString(html, \"text/html\");\n        var g = d.querySelector(\"input[name=csrf]\");\n        if (g && g.value) alan.value = g.value;\n      })\n      .catch(function () {})\n      .then(function () { if (bitti) bitti(); });\n  }\n\n  function sec(ad, odak) {\n    for (var i = 0; i < sekmeler.length; i++) {\n      var s = sekmeler[i];\n      var acik = s.getAttribute(\"data-sekme\") === ad;\n      s.setAttribute(\"aria-selected\", acik ? \"true\" : \"false\");\n      s.tabIndex = acik ? 0 : -1;\n      var p = document.getElementById(s.getAttribute(\"aria-controls\"));\n      p.hidden = !acik;\n      if (acik) {\n        var f = p.querySelector(\"form\");\n        if (f) belirtecAl(f);\n        if (odak) s.focus();\n      }\n    }\n  }\n  for (var i = 0; i < sekmeler.length; i++) {\n    sekmeler[i].addEventListener(\"click\", function () { sec(this.getAttribute(\"data-sekme\")); });\n    sekmeler[i].addEventListener(\"keydown\", function (e) {\n      if (e.key !== \"ArrowRight\" && e.key !== \"ArrowLeft\") return;\n      var dizi = Array.prototype.slice.call(sekmeler);\n      var n = dizi.indexOf(this);\n      var ileri = (e.key === \"ArrowRight\") !== (document.documentElement.dir === \"rtl\");\n      var y = dizi[(n + (ileri ? 1 : dizi.length - 1)) % dizi.length];\n      sec(y.getAttribute(\"data-sekme\"), true);\n      e.preventDefault();\n    });\n  }\n  var gecis = kok.querySelectorAll(\"[data-git]\");\n  for (var j = 0; j < gecis.length; j++) {\n    gecis[j].addEventListener(\"click\", function (e) { e.preventDefault(); sec(this.getAttribute(\"data-git\"), true); });\n  }\n  var ilk = (location.hash || \"\").replace(\"#\", \"\");\n  sec(ilk === \"uye-ol\" || ilk === \"sifre\" ? ilk : \"giris\");\n\n  var goster = kok.querySelector(\".wylogin-goster\");\n  goster.addEventListener(\"click\", function () {\n    var inp = document.getElementById(\"wylogin-sifre\");\n    var gizli = inp.type === \"password\";\n    inp.type = gizli ? \"text\" : \"password\";\n    goster.textContent = gizli ? M.gizle : M.goster;\n    goster.setAttribute(\"aria-pressed\", gizli ? \"true\" : \"false\");\n  });\n\n  var gf = document.getElementById(\"wylogin-giris-form\");\n  var mesaj = document.getElementById(\"wylogin-mesaj\");\n  var dugme = gf.querySelector(\"button[type=submit]\");\n  function hata(metin) { mesaj.textContent = metin; mesaj.hidden = false; dugme.disabled = false; dugme.textContent = M.b1; }\n  gf.addEventListener(\"submit\", function (e) {\n    e.preventDefault();\n    var eposta = gf.eposta.value.trim();\n    var sifre = gf.sifre.value;\n    if (!eposta || !sifre) { hata(M.eksik); return; }\n    mesaj.hidden = true;\n    dugme.disabled = true;\n    dugme.textContent = M.bekle;\n    fetch(\"/api/portal/giris\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ eposta: eposta, sifre: sifre }),\n      credentials: \"include\"\n    }).then(function (res) {\n      if (res.ok) { window.location.href = \"/musteri\"; return; }\n      return res.json().catch(function () { return {}; }).then(function (j) {\n        var sunucu = j && (j.hata || j.mesaj || j.error);\n        if (trMi && sunucu) hata(sunucu);\n        else hata(res.status === 429 ? M.cok : M.hata);\n      });\n    }).catch(function () { hata(M.ag); });\n  });\n\n  var formlar = kok.querySelectorAll(\"form[data-belirtec]\");\n  for (var k = 0; k < formlar.length; k++) {\n    formlar[k].addEventListener(\"submit\", function (e) {\n      var f = this;\n      var b = f.querySelector(\"button[type=submit]\");\n      if (f.getAttribute(\"data-gonderiliyor\")) { e.preventDefault(); return; }\n      if (f.querySelector(\"input[name=csrf]\").value) { f.setAttribute(\"data-gonderiliyor\", \"1\"); b.disabled = true; b.textContent = M.gonder; return; }\n      e.preventDefault();\n      f.setAttribute(\"data-gonderiliyor\", \"1\");\n      b.disabled = true;\n      b.textContent = M.gonder;\n      belirtecAl(f, function () { f.submit(); });\n    });\n  }\n})();\n</script>",
    "ar": "<style>\n#wylogin{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 16px 48px;box-sizing:border-box}\n#wylogin *{box-sizing:border-box}\n#wylogin .wylogin-kart{width:100%;max-width:460px;background:var(--mx-site-surface,#ffffff);color:var(--mx-site-text,#1b1b1b);border:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 14%,transparent);border-radius:16px;box-shadow:0 12px 32px color-mix(in srgb,var(--mx-site-text,#1b1b1b) 10%,transparent);overflow:hidden}\n#wylogin .wylogin-sekmeler{display:flex;border-bottom:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 14%,transparent)}\n#wylogin .wylogin-sekme{flex:1;min-height:48px;padding:12px 8px;border:0;border-bottom:3px solid transparent;background:transparent;color:inherit;font:inherit;font-size:15px;font-weight:600;cursor:pointer;opacity:.72;transition:opacity .2s ease,border-color .2s ease}\n#wylogin .wylogin-sekme:hover{opacity:1}\n#wylogin .wylogin-sekme[aria-selected=\"true\"]{opacity:1;border-bottom-color:var(--mx-site-primary,#CC1F1B);color:var(--mx-site-primary,#CC1F1B)}\n#wylogin .wylogin-sekme:focus-visible{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:-2px}\n#wylogin .wylogin-panel{padding:24px}\n#wylogin .wylogin-panel[hidden]{display:none}\n#wylogin .wylogin-panel h2{margin:0 0 6px;font-size:22px;line-height:1.3}\n#wylogin .wylogin-panel>p{margin:0 0 18px;font-size:14px;line-height:1.55;opacity:.8}\n#wylogin form{display:flex;flex-direction:column;gap:14px;margin:0}\n#wylogin label{display:block;margin:0 0 6px;font-size:14px;font-weight:600}\n#wylogin label span{font-weight:400;opacity:.7}\n#wylogin input,#wylogin textarea{width:100%;min-height:46px;padding:10px 12px;border:1px solid color-mix(in srgb,var(--mx-site-text,#1b1b1b) 24%,transparent);border-radius:10px;background:var(--mx-site-bg,#ffffff);color:var(--mx-site-text,#1b1b1b);font:inherit;font-size:16px}\n#wylogin textarea{min-height:90px;resize:vertical}\n#wylogin input:focus,#wylogin textarea:focus{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:1px;border-color:var(--mx-site-primary,#CC1F1B)}\n#wylogin .wylogin-sifre{position:relative}\n#wylogin .wylogin-sifre input{padding-inline-end:84px}\n#wylogin .wylogin-goster{position:absolute;inset-inline-end:6px;top:50%;transform:translateY(-50%);min-height:34px;padding:4px 10px;border:0;border-radius:8px;background:transparent;color:var(--mx-site-primary,#CC1F1B);font:inherit;font-size:13px;font-weight:600;cursor:pointer}\n#wylogin .wylogin-dugme{width:100%;min-height:48px;margin-top:4px;padding:12px 18px;border:0;border-radius:10px;background:var(--mx-site-primary,#CC1F1B);color:var(--mx-site-primary-contrast,#ffffff);font:inherit;font-size:16px;font-weight:700;cursor:pointer;transition:filter .2s ease}\n#wylogin .wylogin-dugme:hover{filter:brightness(1.08)}\n#wylogin .wylogin-dugme:disabled{opacity:.6;cursor:wait}\n#wylogin .wylogin-dugme:focus-visible{outline:2px solid var(--mx-site-primary,#CC1F1B);outline-offset:2px}\n#wylogin .wylogin-mesaj{margin:0;padding:10px 12px;border-radius:10px;font-size:14px;line-height:1.45;background:color-mix(in srgb,#d93025 10%,transparent);color:#b3261e;border:1px solid color-mix(in srgb,#d93025 30%,transparent)}\n#wylogin .wylogin-mesaj[hidden]{display:none}\n#wylogin .wylogin-alt{margin:16px 0 0;font-size:14px;line-height:1.55;text-align:center}\n#wylogin .wylogin-alt a,#wylogin .wylogin-baglanti{color:var(--mx-site-primary,#CC1F1B);font-weight:600;text-decoration:underline;text-underline-offset:2px;background:none;border:0;padding:0;font:inherit;font-size:14px;cursor:pointer}\n#wylogin .wylogin-kvkk{margin:16px 0 0;font-size:12px;line-height:1.5;opacity:.75;text-align:center}\n#wylogin .wylogin-kvkk a{color:inherit}\n@media (max-width:520px){#wylogin{padding:0 0 32px}#wylogin .wylogin-kart{border-radius:0;border-inline:0;box-shadow:none}#wylogin .wylogin-panel{padding:20px 16px}#wylogin .wylogin-sekme{font-size:14px;padding:12px 4px}}\n</style>\n<section class=\"wylogin\" id=\"wylogin\" data-metin=\"{&quot;goster&quot;: &quot;إظهار&quot;, &quot;gizle&quot;: &quot;إخفاء&quot;, &quot;b1&quot;: &quot;تسجيل الدخول&quot;, &quot;bekle&quot;: &quot;جارٍ تسجيل الدخول…&quot;, &quot;hata&quot;: &quot;البريد الإلكتروني أو كلمة المرور غير صحيحة.&quot;, &quot;cok&quot;: &quot;محاولات كثيرة جدًا. يرجى المحاولة بعد 15 دقيقة.&quot;, &quot;ag&quot;: &quot;تعذّر الاتصال. يرجى المحاولة مرة أخرى.&quot;, &quot;eksik&quot;: &quot;البريد الإلكتروني وكلمة المرور مطلوبان.&quot;, &quot;gonder&quot;: &quot;جارٍ الإرسال…&quot;}\">\n<div class=\"wylogin-kart\">\n<div class=\"wylogin-sekmeler\" role=\"tablist\" aria-label=\"خيارات الدخول\">\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-giris\" data-sekme=\"giris\" aria-controls=\"wylogin-panel-giris\" aria-selected=\"true\">تسجيل الدخول</button>\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-uye-ol\" data-sekme=\"uye-ol\" aria-controls=\"wylogin-panel-uye-ol\" aria-selected=\"false\" tabindex=\"-1\">إنشاء عضوية</button>\n<button type=\"button\" class=\"wylogin-sekme\" role=\"tab\" id=\"wylogin-sekme-sifre\" data-sekme=\"sifre\" aria-controls=\"wylogin-panel-sifre\" aria-selected=\"false\" tabindex=\"-1\">نسيت كلمة المرور</button>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-giris\" aria-labelledby=\"wylogin-sekme-giris\">\n<h2>الدخول إلى بوابة العملاء</h2><p>سجّل الدخول إلى لوحة عملاء Webyapar باستخدام بريدك الإلكتروني وكلمة المرور.</p>\n<form id=\"wylogin-giris-form\" method=\"post\" action=\"/api/portal/giris\" novalidate>\n<p class=\"wylogin-mesaj\" id=\"wylogin-mesaj\" role=\"alert\" hidden></p>\n<div><label for=\"wylogin-eposta\">البريد الإلكتروني</label><input id=\"wylogin-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"username\" inputmode=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-sifre\">كلمة المرور</label><div class=\"wylogin-sifre\"><input id=\"wylogin-sifre\" name=\"sifre\" type=\"password\" autocomplete=\"current-password\" maxlength=\"128\" required><button type=\"button\" class=\"wylogin-goster\" aria-controls=\"wylogin-sifre\" aria-pressed=\"false\">إظهار</button></div></div>\n<button type=\"submit\" class=\"wylogin-dugme\">تسجيل الدخول</button>\n</form>\n<p class=\"wylogin-alt\"><a href=\"#sifre\" data-git=\"sifre\">نسيت كلمة المرور؟</a></p>\n<p class=\"wylogin-alt\">ليس لديك حساب؟ <a href=\"#uye-ol\" data-git=\"uye-ol\">أرسل طلب عضوية</a></p>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-uye-ol\" aria-labelledby=\"wylogin-sekme-uye-ol\" hidden>\n<h2>طلب عضوية</h2><p>اترك بياناتك؛ يراجع فريق Webyapar طلبك ويتواصل معك خلال 7 أيام. يُفتح حساب البوابة عبر رابط الدعوة الذي نرسله.</p>\n<form method=\"POST\" action=\"/musteri/uyelik-talebi\" data-belirtec=\"uyelik\">\n<input type=\"hidden\" name=\"csrf\" value=\"\">\n<div><label for=\"wylogin-u-ad\">الاسم الكامل</label><input id=\"wylogin-u-ad\" name=\"ad\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" required></div>\n<div><label for=\"wylogin-u-eposta\">البريد الإلكتروني</label><input id=\"wylogin-u-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-u-sirket\">الشركة</label><input id=\"wylogin-u-sirket\" name=\"sirket\" type=\"text\" autocomplete=\"organization\" maxlength=\"160\" required></div>\n<div><label for=\"wylogin-u-notu\">ملاحظة <span>(اختياري)</span></label><textarea id=\"wylogin-u-notu\" name=\"notu\" maxlength=\"2000\"></textarea></div>\n<button type=\"submit\" class=\"wylogin-dugme\">إنشاء عضوية</button>\n</form>\n<p class=\"wylogin-kvkk\">تُستخدم بياناتك فقط لتقييم طلبك · <a href=\"/musteri/kvkk\">إشعار الخصوصية (KVKK)</a></p>\n</div>\n<div class=\"wylogin-panel\" role=\"tabpanel\" id=\"wylogin-panel-sifre\" aria-labelledby=\"wylogin-sekme-sifre\" hidden>\n<h2>نسيت كلمة المرور</h2><p>اكتب بريدك الإلكتروني المسجّل في البوابة واسمك؛ سنتواصل معك للتحقق من هويتك حتى تعيد تعيين كلمة المرور.</p>\n<form method=\"POST\" action=\"/musteri/sifre-unuttum\" data-belirtec=\"sifre\">\n<input type=\"hidden\" name=\"csrf\" value=\"\">\n<div><label for=\"wylogin-s-eposta\">البريد الإلكتروني</label><input id=\"wylogin-s-eposta\" name=\"eposta\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" required></div>\n<div><label for=\"wylogin-s-ad\">الاسم الكامل</label><input id=\"wylogin-s-ad\" name=\"ad\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" required></div>\n<div><label for=\"wylogin-s-telefon\">الهاتف <span>(اختياري)</span></label><input id=\"wylogin-s-telefon\" name=\"telefon\" type=\"tel\" autocomplete=\"tel\" maxlength=\"30\"></div>\n<button type=\"submit\" class=\"wylogin-dugme\">إرسال</button>\n</form>\n<p class=\"wylogin-kvkk\">تُستخدم بياناتك فقط لتقييم طلبك · <a href=\"/musteri/kvkk\">إشعار الخصوصية (KVKK)</a></p>\n</div>\n</div>\n</section>\n<script>\n(function () {\n  var kok = document.getElementById(\"wylogin\");\n  if (!kok) return;\n  var M = JSON.parse(kok.getAttribute(\"data-metin\"));\n  var trMi = (document.documentElement.lang || \"tr\").slice(0, 2) === \"tr\";\n  var sekmeler = kok.querySelectorAll(\".wylogin-sekme\");\n  var BELIRTEC = { uyelik: \"/musteri/uyelik\", sifre: \"/musteri/sifre-unuttum\" };\n\n  function belirtecAl(form, bitti) {\n    var tur = form.getAttribute(\"data-belirtec\");\n    var alan = form.querySelector(\"input[name=csrf]\");\n    if (!tur || !alan || alan.value) { if (bitti) bitti(); return; }\n    fetch(BELIRTEC[tur], { credentials: \"include\", headers: { \"Accept\": \"text/html\" } })\n      .then(function (r) { return r.ok ? r.text() : \"\"; })\n      .then(function (html) {\n        var d = new DOMParser().parseFromString(html, \"text/html\");\n        var g = d.querySelector(\"input[name=csrf]\");\n        if (g && g.value) alan.value = g.value;\n      })\n      .catch(function () {})\n      .then(function () { if (bitti) bitti(); });\n  }\n\n  function sec(ad, odak) {\n    for (var i = 0; i < sekmeler.length; i++) {\n      var s = sekmeler[i];\n      var acik = s.getAttribute(\"data-sekme\") === ad;\n      s.setAttribute(\"aria-selected\", acik ? \"true\" : \"false\");\n      s.tabIndex = acik ? 0 : -1;\n      var p = document.getElementById(s.getAttribute(\"aria-controls\"));\n      p.hidden = !acik;\n      if (acik) {\n        var f = p.querySelector(\"form\");\n        if (f) belirtecAl(f);\n        if (odak) s.focus();\n      }\n    }\n  }\n  for (var i = 0; i < sekmeler.length; i++) {\n    sekmeler[i].addEventListener(\"click\", function () { sec(this.getAttribute(\"data-sekme\")); });\n    sekmeler[i].addEventListener(\"keydown\", function (e) {\n      if (e.key !== \"ArrowRight\" && e.key !== \"ArrowLeft\") return;\n      var dizi = Array.prototype.slice.call(sekmeler);\n      var n = dizi.indexOf(this);\n      var ileri = (e.key === \"ArrowRight\") !== (document.documentElement.dir === \"rtl\");\n      var y = dizi[(n + (ileri ? 1 : dizi.length - 1)) % dizi.length];\n      sec(y.getAttribute(\"data-sekme\"), true);\n      e.preventDefault();\n    });\n  }\n  var gecis = kok.querySelectorAll(\"[data-git]\");\n  for (var j = 0; j < gecis.length; j++) {\n    gecis[j].addEventListener(\"click\", function (e) { e.preventDefault(); sec(this.getAttribute(\"data-git\"), true); });\n  }\n  var ilk = (location.hash || \"\").replace(\"#\", \"\");\n  sec(ilk === \"uye-ol\" || ilk === \"sifre\" ? ilk : \"giris\");\n\n  var goster = kok.querySelector(\".wylogin-goster\");\n  goster.addEventListener(\"click\", function () {\n    var inp = document.getElementById(\"wylogin-sifre\");\n    var gizli = inp.type === \"password\";\n    inp.type = gizli ? \"text\" : \"password\";\n    goster.textContent = gizli ? M.gizle : M.goster;\n    goster.setAttribute(\"aria-pressed\", gizli ? \"true\" : \"false\");\n  });\n\n  var gf = document.getElementById(\"wylogin-giris-form\");\n  var mesaj = document.getElementById(\"wylogin-mesaj\");\n  var dugme = gf.querySelector(\"button[type=submit]\");\n  function hata(metin) { mesaj.textContent = metin; mesaj.hidden = false; dugme.disabled = false; dugme.textContent = M.b1; }\n  gf.addEventListener(\"submit\", function (e) {\n    e.preventDefault();\n    var eposta = gf.eposta.value.trim();\n    var sifre = gf.sifre.value;\n    if (!eposta || !sifre) { hata(M.eksik); return; }\n    mesaj.hidden = true;\n    dugme.disabled = true;\n    dugme.textContent = M.bekle;\n    fetch(\"/api/portal/giris\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ eposta: eposta, sifre: sifre }),\n      credentials: \"include\"\n    }).then(function (res) {\n      if (res.ok) { window.location.href = \"/musteri\"; return; }\n      return res.json().catch(function () { return {}; }).then(function (j) {\n        var sunucu = j && (j.hata || j.mesaj || j.error);\n        if (trMi && sunucu) hata(sunucu);\n        else hata(res.status === 429 ? M.cok : M.hata);\n      });\n    }).catch(function () { hata(M.ag); });\n  });\n\n  var formlar = kok.querySelectorAll(\"form[data-belirtec]\");\n  for (var k = 0; k < formlar.length; k++) {\n    formlar[k].addEventListener(\"submit\", function (e) {\n      var f = this;\n      var b = f.querySelector(\"button[type=submit]\");\n      if (f.getAttribute(\"data-gonderiliyor\")) { e.preventDefault(); return; }\n      if (f.querySelector(\"input[name=csrf]\").value) { f.setAttribute(\"data-gonderiliyor\", \"1\"); b.disabled = true; b.textContent = M.gonder; return; }\n      e.preventDefault();\n      f.setAttribute(\"data-gonderiliyor\", \"1\");\n      b.disabled = true;\n      b.textContent = M.gonder;\n      belirtecAl(f, function () { f.submit(); });\n    });\n  }\n})();\n</script>"
